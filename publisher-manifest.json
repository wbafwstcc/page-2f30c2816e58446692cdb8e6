ition:absolute;right:20px;top:50%;transform:translateY(-50%);color:var(--amber);font-size:18px;line-height:1}\ndetails[open] summary::after{content:\"－\"}\ndetails summary:hover{background:#fbf8f1}\ndetails .answer{padding:0 22px 22px;font-size:15px;color:#33414f;margin:0}\ndetails[open] summary{border-bottom:1px dashed var(--line)}\n.faq-col-wrap{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 32px;align-items:start}\nfooter{background:var(--deep-2);color:rgba(233,238,244,.72);padding:40px 0 46px;font-size:13.5px}\nfooter .wrap{display:flex;flex-wrap:wrap;gap:12px 28px;align-items:baseline}\nfooter strong{color:var(--white);letter-spacing:.08em;font-family:\"Heiti SC\",\"Noto Sans CJK SC\",system-ui,sans-serif}\nfooter p{margin:0}\nfooter a{color:var(--amber-soft);border-bottom:none}\nfooter a:hover{color:var(--amber)}\n@media (max-width:860px){\n  .hero-grid{grid-template-columns:1fr;gap:30px}\n  .prose{columns:1}\n  .steps{grid-template-columns:1fr}\n  .step{border-right:none;border-bottom:1px solid var(--line);padding-bottom:54px}\n  .step:last-child{border-bottom:none}\n  .plan{grid-template-columns:1fr;gap:18px;padding-bottom:60px}\n  .plan ul{columns:1}\n  .clients{grid-template-columns:1fr}\n  .faq-col-wrap{grid-template-columns:1fr}\n  section{padding:48px 0}\n  header.hero{padding:40px 0 50px}\n  .topbar .stamp{margin-left:0;flex-basis:100%}\n}\n</style><div class=\"topbar\">\n  <div class=\"wrap\">\n    <nav aria-label=\"面包屑\">\n      <ol class=\"crumb\">\n        <li><a href=\"#\">首页</a></li>\n        <li><a href=\"#plans\">订阅方案</a></li>\n        <li>翠鸟云使用说明与方案对照</li>\n      </ol>\n    </nav>\n    <span class=\"stamp\">cuiniaoyun · 站点目录页</span>\n  </div>\n</div>\n\n<div class=\"directory\">\n  <div class=\"wrap\">\n    <span class=\"brandmark\"><a href=\"#\">翠鸟云</a></span>\n    <a href=\"#start\">这篇文章怎么读</a>\n    <a href=\"#howto\">三步完成配置</a>\n    <a href=\"#plans\">三档方案对照</a>\n    <a href=\"#clients\">客户端从哪里开始</a>\n    <a href=\"#faq\">常见问题</a>\n  </div>\n</div>\n\n<header class=\"hero\">\n  <div class=\"wrap hero-grid\">\n    <div>\n      <p class=\"kicker\">CUINIAOYUN · 专栏</p>\n      <h1>翠鸟云(cuiniaoyun) · 翠鸟云：先弄清自己要什么，再决定订阅哪一档</h1>\n      <p class=\"byline\">编辑手记 · 面向第一次了解翠鸟云 cuiniaoyun 的读者</p>\n      <p class=\"lede\">挑选订阅，很多时候不是被价格难住，而是被自己的需求难住。有人需要的是三台设备同时在线，有人真正在意的是线路质量，还有人其实是替一支小团队挑一个能长期沿用的方案。这三件事指向的答案完全不同。</p>\n      <p class=\"lede\">这篇长文不打算用一堆形容词说服你。我们把翠鸟云目前展示的三层方案摊开，按“谁适合、为什么要付这笔钱、订阅之后第一步做什么”的顺序讲下去。读完之后，你应当能自己判断该停在哪一档，而不是靠猜。</p>\n    </div>\n    <aside class=\"sidecard\" aria-label=\"页面导览\">\n      <h2>本文包含</h2>\n      <ol>\n        <li>为什么先谈需求，再谈价格</li>\n        <li>三步完成配置：账号、客户端、日常使用</li>\n        <li>基础版、旗舰版、团队版的递进关系</li>\n        <li>客户端与设备数量的实际含义</li>\n        <li>按主题分组的常见问题</li>\n      </ol>\n      <p class=\"note\">本文中的价格与权益来自翠鸟云当前展示的方案列表，若与站内最新页面有出入，以你下单时看到的页面为准。</p>\n    </aside>\n  </div>\n</header>\n\n<main>\n\n  <section id=\"start\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div class=\"rule\"></div>\n        <h2>先谈需求，再谈价格</h2>\n        <p>订阅这件事的顺序常常被弄反：先看价目表，再回头替价格找理由。翠鸟云的三档方案更像一条阶梯，每一级多花的钱，都对应着一个具体的能力增量。</p>\n      </div>\n      <div class=\"prose\">\n        <p>第一层增量是流量与设备数。基础版给出每月 100GB 与 3 台设备同时在线，这个组合对应的是一种相对轻量的使用节奏：一两台电脑、一部手机，不长时间挂着大流量任务。它的价值不在于“便宜”，而在于不为用不到的东西付费。</p>\n        <p>第二层增量是线路与并发。旗舰版把流量提到每月 300GB，设备数提到 5 台，并且加入了 IPLC 专线游戏加速优化与全节点原生流媒体解锁。多出来的这部分支出，买的是稳定性和更少的等待——如果你对延迟敏感，或者家里同时在线的人不止一个，这一档的性价比往往比第一档更合理。</p>\n        <p>第三层增量是管理而非速度。团队版把流量拉到每月 1000GB、设备数 20 台，并提供 VIP 专属高带宽节点、企业定制路由与专属客户经理。它解决的是“一个人替一群人做决定”的问题：设备多、场景杂、出了问题需要有人对接。</p>\n        <div class=\"pull\">\n          <strong>一句话判断</strong>\n          只为自己用，从基础版开始；家里或办公室多人共用，看旗舰版；需要统一管理多台设备与路由策略，才轮到团队版。\n        </div>\n        <p>需要说明的是，三档方案之间是能力叠加，不是彼此替代。你不必因为买了基础版就担心“功能太少”，也不必因为看到团队版就觉得自己错过什么。按真实的使用人数与设备数量对号入座，通常不会选错。</p>\n        <p>至于年付，三档都给出了明显低于月付的年付价格。年付适合已经确认自己会长期使用的人；如果你还在试探阶段，先按月付走一轮，观察自己的实际用量，再决定要不要转成按年，这个顺序更稳妥。</p>\n      </div>\n    </div>\n  </section>\n\n  <div class=\"steps-wrap\" id=\"howto\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div class=\"rule\"></div>\n        <h2>三步完成配置：从注册到日常使用</h2>\n        <p>订阅只是开始。下面三步是按实际动手顺序排列的，每一步都写清了“做完之后应该看到什么”，方便你判断自己是否真的完成了。</p>\n      </div>\n      <div class=\"steps\">\n        <article class=\"step\">\n          <h3>一、确认账号与订阅档位</h3>\n          <p>先完成账号注册，再在方案列表里选定月付或年付。做完这一步，你应该能在账号内看到当前生效的档位名称，以及本计费周期剩余的流量额度。如果页面显示的档位与你选择的不一致，先不要继续往下配置。</p>\n        </article>\n        <article class=\"step\">\n          <h3>二、在客户端里填入订阅信息</h3>\n          <p>翠鸟云不在本文中分发安装包，具体客户端与版本请以账号内的下载说明为准。完成安装后，把你账号中的订阅信息填入客户端，等待节点列表加载出来。做完这一步，你应该能在客户端里看到可选的节点，而不是空白列表。</p>\n        </article>\n        <article class=\"step\">\n          <h3>三、按设备数分配并开始日常使用</h3>\n          <p>回到自己的设备清单，数一数准备同时在线的台数，确保不超过所选档位的上限。做完这一步，你应该清楚哪几台设备长期在线、哪几台只在需要时接入。之后每次续费或升级，都从这份清单出发判断是否需要换档。</p>\n        </article>\n      </div>\n    </div>\n  </div>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div class=\"rule\"></div>\n        <h2>三档方案：一条向上递进的阶梯</h2>\n        <p>下面按由低到高的顺序排列。每一档都列出价格、年付价格与全部权益，方便你横向比对差异究竟出现在哪一行。</p>\n      </div>\n      <div class=\"plans\">\n\n        <article class=\"plan\">\n          <div class=\"tier\">\n            <h3>基础版</h3>\n            <p class=\"price\">¥15<span>/ 月</span></p>\n            <p class=\"annual\">按年付仅需 ¥150 / 年</p>\n          </div>\n          <ul>\n            <li>每月 100GB 极速流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n          <span class=\"bignum\">01</span>\n        </article>\n\n        <article class=\"plan featured\">\n          <div class=\"tier\">\n            <span class=\"tag\">多数人的落点</span>\n            <h3>旗舰版</h3>\n            <p class=\"price\">¥35<span>/ 月</span></p>\n            <p class=\"annual\">按年付仅需 ¥350 / 年</p>\n          </div>\n          <ul>\n            <li>每月 300GB 极速流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7x24 优先工单支持</li>\n          </ul>\n          <span class=\"bignum\">02</span>\n        </article>\n\n        <article class=\"plan\">\n          <div class=\"tier\">\n            <h3>团队版</h3>\n            <p class=\"price\">¥85<span>/ 月</span></p>\n            <p class=\"annual\">按年付仅需 ¥850 / 年</p>\n          </div>\n          <ul>\n            <li>每月 1000GB 极速流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n          <span class=\"bignum\">03</span>\n        </article>\n\n      </div>\n      <p class=\"hintline\">流量、设备数与线路说明均以你下单时页面展示为准。若使用一段时间后发现某档的上限经常被触顶，优先考虑向上一档，而不是临时拼凑多个账号。</p>\n    </div>\n  </section>\n\n  <div class=\"clients-wrap\" id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div class=\"rule\"></div>\n        <h2>客户端：设备数量决定你怎么装</h2>\n        <p>方案里写的“同时在线台数”，指的是同一时刻接入的设备数量，而不是你能安装几次。理解这一点，很多配置上的困惑会自行消解。</p>\n      </div>\n      <div class=\"clients\">\n\n        <article class=\"client\">\n          <h3>电脑端</h3>\n          <p>桌面设备通常是长期在线的那一台，占用一个同时在线名额。适合放在固定位置，订阅信息填好之后不必频繁切换。</p>\n          <p class=\"where\">获取方式：以账号内的下载说明为准</p>\n          <span class=\"bignum\">01</span>\n        </article>\n\n        <article class=\"client\">\n          <h3>手机与平板</h3>\n          <p>移动设备的特点是“用的时候才连”。如果只是偶尔接入，可以与另一台设备错开时间，从而在名额紧张时腾出位置。</p>\n          <p class=\"where\">获取方式：以账号内的下载说明为准</p>\n          <span class=\"bignum\">02</span>\n        </article>\n\n        <article class=\"client\">\n          <h3>多设备共用与团队场景</h3>\n          <p>当同时在线的设备超过 5 台，团队版的 20 台名额才有意义。此时更需要一份清晰的设备清单，而不是逐台临时授权。</p>\n          <p class=\"where\">适用范围：团队版</p>\n          <span class=\"bignum\">03</span>\n        </article>\n\n        <article class=\"client\">\n          <h3>路由与网络层配置</h3>\n          <p>涉及整屋或多个终端统一接入的做法，会牵动路由策略。团队版提供的企业定制路由支持正是为这类场景准备的，个人方案不涉及此项。</p>\n          <p class=\"where\">适用范围：团队版</p>\n          <span class=\"bignum\">04</span>\n        </article>\n\n      </div>\n      <p class=\"hintline\">本文不提供客户端安装包与下载链接，请通过你的账号页面获取；不同系统的安装步骤以客户端内提示为准。</p>\n    </div>\n  </div>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div class=\"rule\"></div>\n        <h2>常见问题</h2>\n        <p>下面按主题分组。每组的问题都来自订阅决策中最容易卡住的地方：选档、用量、设备与配置。</p>\n      </div>\n\n      <div class=\"faq-col-wrap\">\n\n        <div>\n          <div class=\"faq-group\">\n            <h3>一、关于选档</h3>\n\n            <details>\n              <summary>我不确定该选基础版还是旗舰版，有什么判断方法？</summary>\n              <p class=\"answer\">先看两个数字：同时在线的设备台数，以及每月大概会用掉多少流量。设备不超过 3 台、用量平稳，基础版够用；一旦设备达到 4 至 5 台，或者你明确在意线路质量与流媒体解锁范围，就应该直接看旗舰版。多花的这部分钱，对应的是线路与并发能力的提升，而不是单纯的流量数字变大。</p>\n            </details>\n\n            <details>\n              <summary>团队版比旗舰版贵一倍多，值在哪里？</summary>\n              <p class=\"answer\">差价买的是管理能力：20 台设备的并发名额、VIP 专属高带宽节点、企业定制路由支持，以及专属客户经理。如果你只是一个人用几台设备，这些能力基本用不上；如果你需要替一群人维护一套统一的接入方式，这些项目才会真正节省时间。</p>\n            </details>\n\n            <details>\n              <summary>可以先买低档，之后再升级吗？</summary>\n              <p class=\"answer\">可以按需要向上一档调整。比较务实的做法是：先按较低档位走一个完整计费周期，观察自己的实际用量与同时在线台数是否触顶，再决定是否上移。反过来，从高档降回低档之前，先确认自己的设备数量能压到低档上限以内。</p>\n            </details>\n          </div>\n\n          <div class=\"faq-group\">\n            <h3>二、关于流量与计费</h3>\n\n            <details>\n              <summary>每月流量额度是怎样的周期？</summary>\n              <p class=\"answer\">方案中标注的是每月流量额度，按计费周期结算，本期未用完的部分不累积到下一期。三档分别为 100GB、300GB 与 1000GB。建议在周期中段查看一次已用量，判断自己的消耗节奏是否与所选档位匹配。</p>\n            </details>\n\n            <details>\n              <summary>年付和月付应该怎么选？</summary>\n              <p class=\"answer\">年付价格明显低于十二个月的月付总和：基础版 ¥150 / 年、旗舰版 ¥350 / 年、团队版 ¥850 / 年。年付适合已经确认会长期使用的场景；如果还在试探期，先按月付走一轮更稳妥，避免为尚未确认的需求锁定一年。</p>\n            </details>\n          </div>\n        </div>\n\n        <div>\n          <div class=\"faq-group\">\n            <h3>三、关于设备与客户端</h3>\n\n            <details>\n              <summary>“同时在线”具体是什么意思？</summary>\n              <p class=\"answer\">指同一时刻处于连接状态的设备数量上限，而不是累计安装次数或账号数量。同一台设备在不同时间反复连接，只占用一个名额。理解这一点之后，你会发现名额紧张往往来自“设备一直挂着”，而不是“装得太多”。</p>\n            </details>\n\n            <details>\n              <summary>客户端从哪里获取？本文为什么没有下载按钮？</summary>\n              <p class=\"answer\">本文只做说明，不提供安装包与下载链接，以免给出与官方版本不一致的文件。请在你自己的账号页面查看客户端与版本的获取方式，安装过程中的提示以客户端内展示为准。</p>\n            </details>\n\n            <details>\n              <summary>换了新设备，需要重新订阅吗？</summary>\n              <p class=\"answer\">不需要。订阅绑定的是账号与所选档位的设备名额，而不是某一台具体设备。换设备时只要在新设备上按同样的方式填入订阅信息即可，同时留意新旧设备不要在名额紧张时同时在线。</p>\n            </details>\n          </div>\n\n          <div class=\"faq-group\">\n            <h3>四、关于支持与调整</h3>\n\n            <details>\n              <summary>遇到问题时应该先做什么？</summary>\n              <p class=\"answer\">先确认三件事：当前生效的档位是否与你以为的一致、同时在线设备数是否已超过上限、客户端里的节点列表是否已正常加载。绝大多数配置类困惑都落在这三项里。确认之后仍有问题，再通过工单渠道反馈；旗舰版与团队版在工单处理上有优先安排，团队版另有专属客户经理对接。</p>\n            </details>\n\n            <details>\n              <summary>团队版的“定制路由”需要我准备什么？</summary>\n              <p class=\"answer\">这项能力面向需要统一接入策略的场景。沟通时把你的网络结构、需要覆盖的终端数量与期望的接入方式说明清楚，会比笼统提问更有效。具体能实现到什么程度，以对接时的说明为准，本文不代为承诺任何配置结果。</p>\n            </details>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <strong>翠鸟云 cuiniaoyun</strong>\n    <p>本页为订阅与使用说明，价格与权益以下单页面为准。</p>\n    <p><a href=\"#plans\">回到方案对照</a> · <a href=\"#faq\">回到常见问题</a></p>\n  </div>\n</footer>",
